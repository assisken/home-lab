# Cluster-side helpers for Sealed Secrets. `make -C server <target>`; see SECRETS.md.

.PHONY: help install-controller fetch-cert seal backup-key check-cleartext

# Must match helm/sealed-secrets/values.yml.
CONTROLLER_NAME ?= sealed-secrets-controller
CONTROLLER_NS   ?= kube-system

UNSEALED_DIR ?= secrets-unsealed

# Seal offline with the (public) cert from `make fetch-cert`:
#     make seal CERT=$(UNSEALED_DIR)/sealing-cert.pem
CERT ?=
KUBESEAL_ARGS := --format yaml $(if $(CERT),--cert $(CERT),--controller-name $(CONTROLLER_NAME) --controller-namespace $(CONTROLLER_NS))

# <slug>:<dir> — $(UNSEALED_DIR)/<slug>.yaml seals to <dir>/<slug>-sealedsecret.yaml.
# Also add a <slug>-sealedsecret.yaml.example stub in <dir>.
SECRETS := \
	lidarr:apps/lidarr \
	sonarr:apps/sonarr \
	prowlarr:apps/prowlarr \
	suwayomi:apps/suwayomi \
	db-encryption:apps/homarr \
	grafana-admin:monitoring/grafana \
	cloudflare:helm/traefik

help:
	@echo 'Targets (see SECRETS.md for the runbook):'
	@echo '  install-controller  helm upgrade --install the sealed-secrets controller'
	@echo '  fetch-cert          save the controller public key for offline sealing'
	@echo '  seal                reseal every secret in $$(SECRETS)'
	@echo '  seal-<slug>         reseal one, e.g. make seal-sonarr'
	@echo '  backup-key          dump the controller PRIVATE key (do this once, keep it safe)'
	@echo '  check-cleartext     fail if any cleartext secret slipped into the tracked tree'
	@echo ''
	@echo 'Known secrets:'
	@for s in $(SECRETS); do echo "  $${s%%:*}"; done

# Separate from helmfile: on a fresh cluster this must come first.
install-controller:
	helm repo add sealed-secrets https://bitnami.github.io/sealed-secrets
	helm repo update sealed-secrets
	helm upgrade --install sealed-secrets sealed-secrets/sealed-secrets \
		--namespace $(CONTROLLER_NS) --version 2.20.0 \
		-f helm/sealed-secrets/values.yml

fetch-cert:
	kubeseal --controller-name $(CONTROLLER_NAME) --controller-namespace $(CONTROLLER_NS) \
		--fetch-cert > $(UNSEALED_DIR)/sealing-cert.pem
	@echo 'Wrote $(UNSEALED_DIR)/sealing-cert.pem — now: make seal CERT=$(UNSEALED_DIR)/sealing-cert.pem'

# Every sealed file changes on each run; prefer seal-<slug> for small diffs.
seal:
	@for s in $(SECRETS); do $(MAKE) --no-print-directory seal-$${s%%:*} CERT='$(CERT)' || exit 1; done

# Via a temp file, so a kubeseal failure doesn't clobber the old sealed file.
seal-%:
	@dir=$$(printf '%s\n' $(SECRETS) | sed -n 's|^$*:||p'); \
	if [ -z "$$dir" ]; then \
		echo "make: unknown secret '$*'. Known: $$(printf '%s ' $(SECRETS) | sed 's|:[^ ]*||g')" >&2; \
		exit 1; \
	fi; \
	src="$(UNSEALED_DIR)/$*.yaml"; \
	if [ ! -f "$$src" ]; then \
		echo "make: missing cleartext input $$src — see $(UNSEALED_DIR)/README.md" >&2; \
		exit 1; \
	fi; \
	out="$$dir/$*-sealedsecret.yaml"; \
	tmp="$$(mktemp)"; \
	kubeseal $(KUBESEAL_ARGS) < "$$src" > "$$tmp" || { rm -f "$$tmp"; exit 1; }; \
	{ \
		echo "# Generated by \`make -C server seal-$*\` — DO NOT EDIT."; \
		echo "# Cleartext source: server/$(UNSEALED_DIR)/$*.yaml (gitignored)."; \
		echo "# Decryptable only by the sealed-secrets controller of this cluster."; \
		cat "$$tmp"; \
	} > "$$out"; \
	rm -f "$$tmp"; \
	echo "sealed $$src -> $$out"

# Writes the PRIVATE sealing key; without it every sealed secret is lost.
# Rerun after each key renewal, move the output to encrypted storage.
backup-key:
	kubectl get secret -n $(CONTROLLER_NS) \
		-l sealedsecrets.bitnami.com/sealed-secrets-key=active \
		-o yaml > $(UNSEALED_DIR)/sealing-key-backup.yaml
	@echo ''
	@echo 'WROTE $(UNSEALED_DIR)/sealing-key-backup.yaml — this is a PRIVATE KEY.'
	@echo 'Move it to encrypted storage and delete the local copy. See SECRETS.md.'

# Any tracked `kind: Secret` is a committed credential.
check-cleartext:
	@hits=$$(git -C .. grep -lE '^kind:[[:space:]]*Secret[[:space:]]*$$' -- 'server/**/*.yaml' 'server/**/*.yml' || true); \
	if [ -n "$$hits" ]; then \
		echo 'Cleartext Secret manifests are tracked in git:' >&2; \
		echo "$$hits" >&2; \
		echo 'Move them to $(UNSEALED_DIR)/ and seal them. See SECRETS.md.' >&2; \
		exit 1; \
	fi; \
	echo 'No cleartext Secret manifests tracked.'
