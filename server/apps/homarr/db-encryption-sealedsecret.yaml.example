# PLACEHOLDER, not a manifest (see SECRETS.md). The real apps/homarr/db-encryption-sealedsecret.yaml
# comes from `make -C server seal-db-encryption`.
#
# Produces Secret default/db-encryption, consumed by:
#   the homarr chart (SECRET_ENCRYPTION_KEY)
#
# Shape of the sealed output (encryptedData values are ~600-char blobs):
#
#   apiVersion: bitnami.com/v1alpha1
#   kind: SealedSecret
#   metadata:
#     name: db-encryption
#     namespace: default
#   spec:
#     encryptedData:
#       db-encryption-key: AgB...
#     template:
#       metadata:
#         name: db-encryption
#         namespace: default
#       type: Opaque
