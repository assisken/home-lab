# PLACEHOLDER, not a manifest (see SECRETS.md). The real apps/lidarr/lidarr-sealedsecret.yaml
# comes from `make -C server seal-lidarr`.
#
# Produces Secret default/lidarr, consumed by:
#   apps/lidarr/lidarr-deployment.yaml (APIKEY env of the exportarr sidecar)
#
# Shape of the sealed output (encryptedData values are ~600-char blobs):
#
#   apiVersion: bitnami.com/v1alpha1
#   kind: SealedSecret
#   metadata:
#     name: lidarr
#     namespace: default
#   spec:
#     encryptedData:
#       api-key: AgB...
#     template:
#       metadata:
#         name: lidarr
#         namespace: default
#       type: Opaque
