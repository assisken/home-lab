# PLACEHOLDER, not a manifest (see SECRETS.md). The real apps/prowlarr/prowlarr-sealedsecret.yaml
# comes from `make -C server seal-prowlarr`.
#
# Produces Secret default/prowlarr, consumed by:
#   apps/prowlarr/prowlarr-deployment.yaml (APIKEY env of the exportarr sidecar)
#
# Shape of the sealed output (encryptedData values are ~600-char blobs):
#
#   apiVersion: bitnami.com/v1alpha1
#   kind: SealedSecret
#   metadata:
#     name: prowlarr
#     namespace: default
#   spec:
#     encryptedData:
#       api-key: AgB...
#     template:
#       metadata:
#         name: prowlarr
#         namespace: default
#       type: Opaque
