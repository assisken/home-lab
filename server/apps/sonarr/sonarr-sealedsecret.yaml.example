# PLACEHOLDER, not a manifest (see SECRETS.md). The real apps/sonarr/sonarr-sealedsecret.yaml
# comes from `make -C server seal-sonarr`.
#
# Produces Secret default/sonarr, consumed by:
#   apps/sonarr/sonarr-deployment.yaml (APIKEY env of the exportarr sidecar)
#
# Shape of the sealed output (encryptedData values are ~600-char blobs):
#
#   apiVersion: bitnami.com/v1alpha1
#   kind: SealedSecret
#   metadata:
#     name: sonarr
#     namespace: default
#   spec:
#     encryptedData:
#       api-key: AgB...
#     template:
#       metadata:
#         name: sonarr
#         namespace: default
#       type: Opaque
