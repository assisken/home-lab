# PLACEHOLDER, not a manifest (see SECRETS.md). The real apps/suwayomi/suwayomi-sealedsecret.yaml
# comes from `make -C server seal-suwayomi`.
#
# Produces Secret default/suwayomi, consumed by:
#   apps/suwayomi/suwayomi-deployment.yaml (AUTH_USERNAME and AUTH_PASSWORD env, AUTH_MODE=ui_login)
#
# Cleartext input secrets-unsealed/suwayomi.yaml:
#
#   apiVersion: v1
#   kind: Secret
#   metadata:
#     name: suwayomi
#     namespace: default
#   type: Opaque
#   stringData:
#     username: "user"
#     password: "..."                                   # login for https://manga.example.com
#
# Shape of the sealed output (encryptedData values are ~600-char blobs):
#
#   apiVersion: bitnami.com/v1alpha1
#   kind: SealedSecret
#   metadata:
#     name: suwayomi
#     namespace: default
#   spec:
#     encryptedData:
#       password: AgB...
#       username: AgB...
#     template:
#       metadata:
#         name: suwayomi
#         namespace: default
#       type: Opaque
