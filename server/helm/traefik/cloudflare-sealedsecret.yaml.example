# PLACEHOLDER, not a manifest (see SECRETS.md). The real helm/traefik/cloudflare-sealedsecret.yaml
# comes from `make -C server seal-cloudflare`.
#
# kube-system, so NOT part of `kubectl apply -k server` (whose kustomization
# forces namespace: default). Apply it by hand:
#   kubectl apply -f server/helm/traefik/cloudflare-sealedsecret.yaml
#
# Produces Secret kube-system/cloudflare, consumed by:
#   helm/traefik/values.yml (CF_DNS_API_TOKEN)
#
# Shape of the sealed output (encryptedData values are ~600-char blobs):
#
#   apiVersion: bitnami.com/v1alpha1
#   kind: SealedSecret
#   metadata:
#     name: cloudflare
#     namespace: kube-system
#   spec:
#     encryptedData:
#       token: AgB...
#     template:
#       metadata:
#         name: cloudflare
#         namespace: kube-system
#       type: Opaque
