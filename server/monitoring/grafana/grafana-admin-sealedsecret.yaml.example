# PLACEHOLDER, not a manifest (see SECRETS.md). The real
# monitoring/grafana/grafana-admin-sealedsecret.yaml comes from
# `make -C server seal-grafana-admin`.
#
# Produces Secret default/grafana-admin, consumed by:
#   monitoring/grafana/grafana-deployment.yaml (GF_SECURITY_ADMIN_USER/PASSWORD)
#
# Shape of the sealed output (encryptedData values are ~600-char blobs):
#
#   apiVersion: bitnami.com/v1alpha1
#   kind: SealedSecret
#   metadata:
#     name: grafana-admin
#     namespace: default
#   spec:
#     encryptedData:
#       username: AgB...
#       password: AgB...
#     template:
#       metadata:
#         name: grafana-admin
#         namespace: default
#       type: Opaque
