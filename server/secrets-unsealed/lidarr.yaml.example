# Template for secrets-unsealed/lidarr.yaml. scripts/init-secrets.sh copies it
# and fills every @GEN...@ placeholder; replace CHANGE_ME by hand.
# Then: make -C server seal-lidarr
# The *arr app generates its own key on first start: copy it from
# Lidarr -> Settings -> General -> Security -> API Key, reseal, restart.
# Until then only the exportarr sidecar fails; the app itself runs.
apiVersion: v1
kind: Secret
metadata:
  name: lidarr
  namespace: default
type: Opaque
stringData:
  api-key: "CHANGE_ME"
